    <!-- rules -->
    <string name="welcome_title">How checkers works</string>
    <string name="rules_title">Rules</string>
    <string name="rules_1">Slide one square diagonally. If an enemy piece sits next to you with an empty square behind it, jump it.</string>
    <string name="rules_2">If you can keep jumping, you must.</string>
    <string name="rules_3">Reach the far row and a second piece lands on top: that\'s a king, and kings move backwards.</string>
    <string name="rules_4">Take every piece, or leave them no move, and you win.</string>
    <string name="rules_mistakes">Common beginner slips</string>
    <string name="mistake_1">Don\'t rush your back row. Empty it and they crown the moment they get there.</string>
    <string name="mistake_2">Jumps are forced. That free piece is probably bait.</string>
    <string name="mistake_3">After a jump, look again. If you can keep jumping, you must.</string>
    <string name="mistake_4">A king isn\'t safe. Two men can still trap one.</string>
